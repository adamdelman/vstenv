#!/bin/bash
# hub-create-empty: press "Create Empty" in the Cubase Pro Hub, whatever size the Hub window has
# (the button sits at ~69.5% of the width and 45 px above the bottom; checked at 1255x689 and 1568x856).
HERE="$(cd "$(dirname "$0")" && pwd)"
G=$(python3 "$HERE/winclick" "Cubase Pro Hub" --geometry 2>/dev/null) || exit 1
read W H <<<"$(sed -E 's/.*: ([0-9]+)x([0-9]+) at.*/\1 \2/' <<<"$G")"
python3 "$HERE/winclick" "Cubase Pro Hub" $((W*695/1000)) $((H-45))
