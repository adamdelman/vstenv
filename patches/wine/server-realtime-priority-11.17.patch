 static int nice_limit;
+static int rt_limit;  /* highest SCHED_FIFO priority RLIMIT_RTPRIO allows, 0 for none */
+static int rt_guard_prio;  /* SCHED_FIFO priority of the guard thread, 0 when no realtime is handed out */
+
+#ifndef SCHED_RESET_ON_FORK
+#define SCHED_RESET_ON_FORK 0x40000000
+#endif
+
+/* Realtime throttling may be off (sched_rt_runtime_us -1 or equal to the period), so a
+ * SCHED_FIFO thread that spins keeps its CPU forever, and threads that spin on every CPU
+ * they may run on would starve this (SCHED_OTHER) server too. So the threads the server makes
+ * realtime are watched by a guard thread of its own that runs SCHED_FIFO above all of them:
+ * every 250 ms, a thread that ran more than 80% of the time since the last look (at least 200 ms) goes back
+ * to SCHED_OTHER for a second, as Windows' MMCSS keeps 20% of the CPU for other threads.
+ * The guard only sees this table of unix ids (under rt_mutex, which inherits priority, so
+ * the main loop holding it is not starved); it never touches the server's objects. */
+struct rt_entry
+{
+    pid_t              pid, tid;
+    int                prio;    /* the SCHED_FIFO priority the server gave it, 0 for a free slot */
+    int                held;    /* held back at SCHED_OTHER since 'since' */
+    unsigned long long since;   /* CLOCK_MONOTONIC ns of the last look, or of the hold */
+    unsigned long long cpu;     /* its CPU time in ns at 'since' */
+};
+static struct rt_entry rt_table[256];
+static pthread_mutex_t rt_mutex;
+
+static unsigned long long monotonic_ns(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+/* CPU time a thread has used, in ns; 0 when it is gone */
+static int read_cpu_ns( pid_t pid, pid_t tid, unsigned long long *ns )
+{
+    char path[64];
+    FILE *f;
+    int ret;
+
+    snprintf( path, sizeof(path), "/proc/%d/task/%d/schedstat", pid, tid );
+    if (!(f = fopen( path, "r" ))) return 0;
+    ret = fscanf( f, "%llu", ns ) == 1;
+    fclose( f );
+    return ret;
+}
+
+/* the thread runs with this policy (and SCHED_FIFO priority) */
+static int has_policy( pid_t tid, int policy, int prio )
+{
+    struct sched_param param;
+
+    if ((sched_getscheduler( tid ) & ~SCHED_RESET_ON_FORK) != policy) return 0;
+    return policy != SCHED_FIFO || (!sched_getparam( tid, &param ) && param.sched_priority == prio);
+}
+
+static void *rt_guard( void *arg )
+{
+    const struct timespec tick = { 0, 250000000 };
+    struct sched_param param;
+    unsigned long long now, cpu;
+    struct rt_entry *e;
+
+    for (;;)
+    {
+        nanosleep( &tick, NULL );
+        pthread_mutex_lock( &rt_mutex );
+        now = monotonic_ns();
+        for (e = rt_table; e < rt_table + ARRAY_SIZE(rt_table); e++)
+        {
+            if (!e->prio) continue;
+            if (e->held)
+            {
+                if (now - e->since < 1000000000ull) continue;
+                param.sched_priority = e->prio;
+                /* someone else changed it meanwhile: theirs now */
+                if (!has_policy( e->tid, SCHED_OTHER, 0 ) ||
+                    sched_setscheduler( e->tid, SCHED_FIFO | SCHED_RESET_ON_FORK, &param ))
+                {
+                    e->prio = 0;
+                    continue;
+                }
+                e->held = 0;
+            }
+            else if (!has_policy( e->tid, SCHED_FIFO, e->prio ) || !read_cpu_ns( e->pid, e->tid, &cpu ))
+            {
+                e->prio = 0;  /* gone, or someone else changed it */
+                continue;
+            }
+            else if (now - e->since < 200000000ull) continue;  /* too short a time to judge: keep the baseline */
+            else if ((cpu - e->cpu) * 5 > (now - e->since) * 4)
+            {
+                if (debug_level) fprintf( stderr, "wineserver: unix thread %d ran %llu of the last %llu ms at SCHED_FIFO, held back\n",
+                                          e->tid, (cpu - e->cpu) / 1000000, (now - e->since) / 1000000 );
+                param.sched_priority = 0;
+                sched_setscheduler( e->tid, SCHED_OTHER | SCHED_RESET_ON_FORK, &param );
+                e->held = 1;
+                e->since = now;
+                continue;
+            }
+            e->since = now;
+            if (!read_cpu_ns( e->pid, e->tid, &e->cpu )) e->prio = 0;
+        }
+        pthread_mutex_unlock( &rt_mutex );
+    }
+    return NULL;
+}
+
+/* start the guard; without it no thread is made realtime */
+static void init_rt_guard(void)
+{
+    pthread_mutexattr_t mattr;
+    pthread_attr_t attr;
+    struct sched_param param;
+    sigset_t all, old;
+    pthread_t guard;
+
+    if (rt_limit < 2) return;  /* the guard must run above the threads it watches */
+    param.sched_priority = min( rt_limit, 81 );
+    pthread_mutexattr_init( &mattr );
+    pthread_mutexattr_setprotocol( &mattr, PTHREAD_PRIO_INHERIT );
+    pthread_mutex_init( &rt_mutex, &mattr );
+    pthread_attr_init( &attr );
+    pthread_attr_setinheritsched( &attr, PTHREAD_EXPLICIT_SCHED );
+    pthread_attr_setschedpolicy( &attr, SCHED_FIFO );
+    pthread_attr_setschedparam( &attr, &param );
+    pthread_attr_setstacksize( &attr, 64 * 1024 );
+    sigfillset( &all );
+    pthread_sigmask( SIG_SETMASK, &all, &old );  /* the server's signals stay with the main thread */
+    if (!pthread_create( &guard, &attr, rt_guard, NULL )) rt_guard_prio = param.sched_priority;
+    else if (debug_level) fprintf( stderr, "wineserver: no SCHED_FIFO guard thread, no realtime threads\n" );
+    pthread_sigmask( SIG_SETMASK, &old, NULL );
+    pthread_attr_destroy( &attr );
+}
+
+/* make the thread SCHED_FIFO at prio, or not realtime for prio 0; returns 0 to leave the thread alone */
+static int set_thread_rt_priority( struct thread *thread, int prio )
+{
+    struct sched_param param = { 0 };
+    struct rt_entry *e = NULL, *free_slot = NULL;
+    int policy, ret = 1;
+
+    if (!rt_guard_prio) return 1;
+    pthread_mutex_lock( &rt_mutex );
+    for (e = rt_table; e < rt_table + ARRAY_SIZE(rt_table); e++)
+    {
+        if (e->prio && e->tid == thread->unix_tid && e->pid == thread->unix_pid) break;
+        if (!e->prio && !free_slot) free_slot = e;
+    }
+    if (e == rt_table + ARRAY_SIZE(rt_table)) e = NULL;
+
+    policy = sched_getscheduler( thread->unix_tid ) & ~SCHED_RESET_ON_FORK;
+    /* a thread made realtime by someone else (pipewire-jack's data loop) is left alone */
+    if (!e && (policy == SCHED_FIFO || policy == SCHED_RR)) ret = 0;
+    else if (prio && e && e->held) e->prio = prio;  /* the guard gives it back */
+    else if (prio && (e || (e = free_slot)))
+    {
+        param.sched_priority = prio;
+        if (!sched_setscheduler( thread->unix_tid, SCHED_FIFO | SCHED_RESET_ON_FORK, &param ))
+        {
+            if (!e->prio)
+            {
+                memset( e, 0, sizeof(*e) );
+                e->pid = thread->unix_pid;
+                e->tid = thread->unix_tid;
+                e->since = monotonic_ns();
+                read_cpu_ns( e->pid, e->tid, &e->cpu );
+            }
+            e->prio = prio;
+        }
+        else if (e->prio)
+        {
+            sched_setscheduler( thread->unix_tid, SCHED_OTHER | SCHED_RESET_ON_FORK, &param );
+            e->prio = 0;
+        }
+    }
+    else if (e)
+    {
+        if (!e->held) sched_setscheduler( thread->unix_tid, SCHED_OTHER | SCHED_RESET_ON_FORK, &param );
+        e->prio = 0;
+    }
+    thread->rt_priority = e ? e->prio : 0;
+    pthread_mutex_unlock( &rt_mutex );
+    return ret;
+}
 
