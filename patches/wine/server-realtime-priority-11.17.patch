 #if defined(__linux__) && defined(RLIMIT_NICE)
 static int nice_limit;
+static int rt_limit;  /* highest SCHED_FIFO priority RLIMIT_RTPRIO allows, 0 for none */
+
+#ifndef SCHED_RESET_ON_FORK
+#define SCHED_RESET_ON_FORK 0x40000000
+#endif
+
+static void apply_thread_priority( struct thread *thread );
+static struct timeout_user *rt_watchdog_user;
+
+/* CPU time a thread has used, in ns (0 when unknown) */
+static unsigned long long thread_cpu_ns( struct thread *thread )
+{
+    char path[64];
+    unsigned long long ns = 0;
+    FILE *f;
+
+    snprintf( path, sizeof(path), "/proc/%d/task/%d/schedstat", thread->unix_pid, thread->unix_tid );
+    if (!(f = fopen( path, "r" ))) return 0;
+    if (fscanf( f, "%llu", &ns ) != 1) ns = 0;
+    fclose( f );
+    return ns;
+}
+
+/* Realtime throttling may be off (sched_rt_runtime_us -1 or equal to the period), so a
+ * SCHED_FIFO thread that spins could keep a CPU forever. Every second, a thread the server
+ * made realtime that ran more than 90% of the last second goes back to SCHED_OTHER for a
+ * second, as Windows' MMCSS holds back a thread that overruns its share. */
+static void rt_watchdog( void *private )
+{
+    struct thread *thread;
+    unsigned long long ns;
+    struct sched_param param = { 0 };
+    int armed = 0;
+
+    rt_watchdog_user = NULL;
+    LIST_FOR_EACH_ENTRY( thread, &thread_list, struct thread, entry )
+    {
+        if (!thread->rt_priority || thread->unix_tid == -1) continue;
+        if (thread->rt_priority < 0)  /* held back for a second: realtime again */
+        {
+            thread->rt_priority = 0;
+            apply_thread_priority( thread );
+        }
+        else if ((ns = thread_cpu_ns( thread )) && thread->rt_runtime && ns - thread->rt_runtime > 900000000ull)
+        {
+            if (debug_level) fprintf( stderr, "%04x: ran %llu ms of the last second at SCHED_FIFO, held back\n",
+                                      thread->id, (ns - thread->rt_runtime) / 1000000 );
+            sched_setscheduler( thread->unix_tid, SCHED_OTHER | SCHED_RESET_ON_FORK, &param );
+            thread->rt_priority = -1;
+            apply_thread_priority( thread );  /* the nice value instead */
+        }
+        if (thread->rt_priority) thread->rt_runtime = thread_cpu_ns( thread );
+        armed |= thread->rt_priority != 0;
+    }
+    /* apply_thread_priority may have armed it already */
+    if (armed && !rt_watchdog_user) rt_watchdog_user = add_timeout_user( -TICKS_PER_SEC, rt_watchdog, NULL );
+}
 
