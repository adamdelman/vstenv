+static HRESULT create_calendar( DateTime time, ICalendar **out )
+{
+    struct calendar *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->ICalendar_iface.lpVtbl = &calendar_vtbl;
+    impl->ref = 1;
+    impl->time = time;
+    *out = &impl->ICalendar_iface;
+    return S_OK;
+}
