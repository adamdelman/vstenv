+/* The default calendar of the user's languages, set to the current time. */
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **out )
+{
+    ICalendar *calendar;
+    HRESULT hr;
+
+    TRACE( "iface %p, out %p.\n", iface, out );
+
+    if (FAILED(hr = create_calendar( (DateTime){0}, &calendar ))) return hr;
+    ICalendar_SetToNow( calendar );
+    *out = (IInspectable *)calendar;
+    return S_OK;
